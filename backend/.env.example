# Copy to .env for local runs. Every value has a sane default in settings.py except
# the three secrets MAILGUN__API_KEY, NTFY__TOKEN and AUTH__API_TOKEN, which must be set explicitly.
APP_ENV=dev
HTTP_PORT=8140
LOG_LEVEL=INFO

MYSQL__HOST=localhost
MYSQL__PORT=8142
MYSQL__USER=root
MYSQL__PASSWORD=
MYSQL__DATABASE=hablator

# Email channel (`MAILGUN__*`). `MAILGUN__API_KEY` is the provider secret: it has no default in
# code, so a real deploy must set it; this is the dev fixture. `from`/`bcc` are the bootstrap
# fallbacks a `provider_config` row overrides at dispatch.
MAILGUN__API_KEY=dev-hablator-mailgun-key
MAILGUN__API_URL=https://api.mailgun.net/v3/hablator.invalid/messages
MAILGUN__FROM=hablator@hablator.invalid
MAILGUN__BCC=hablator-archive@hablator.invalid

# Push channel (`NTFY__*`). `NTFY__TOKEN` is the provider secret (the `hablator-backend` admin
# token): it has no default in code, so a real deploy must set it; this is the dev fixture.
# The topic itself is non-secret provider config, written through `PUT /channels/push`.
NTFY__BASE_URL=http://localhost:2586
NTFY__TOKEN=dev-hablator-ntfy-token

# The new API's single Bearer token. No default in code: a real deploy must set it.
AUTH__API_TOKEN=dev-hablator-api-token

# Unset follows HTTP_PORT (http://localhost:<port>); set explicitly to override (container/deploy).
# GATEWAYS__APP__HOST=http://localhost:8140

# Telemetry — dev fixtures only. The endpoint defaults to a local Collector under
# APP_ENV=dev and is required under APP_ENV=prod; APP_ENV=test exports nothing.
# OTEL_SERVICE_NAME=hablator
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# TELEMETRY_CONSOLE=false
# SERVICE_VERSION=dev

# The standard contract the exporters and instrumentation read.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=none
OTEL_BLRP_SCHEDULE_DELAY=5000
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_SEMCONV_STABILITY_OPT_IN=http,database
