# Base URL of the backend API.
# In dev, leave as "/api" and Vite proxies to VITE_API_TARGET (see vite.config.ts).
# In prod behind the reverse proxy, set to e.g. "/hablator-api" or the absolute origin.
VITE_API_BASE=/api

# Dev-only: where the Vite proxy forwards /api to, and the port the dev server binds.
# The dev server is strict — a taken FRONTEND_DEV_PORT fails instead of auto-incrementing.
VITE_API_TARGET=http://localhost:8140
FRONTEND_DEV_PORT=8143

# Dev-only: the Bearer token the /api proxy injects, mirroring the image's nginx proxy. The SPA
# never reads it. Use the same value as the backend's AUTH__API_TOKEN; the committed fixture
# matches backend/.env.example.
AUTH__API_TOKEN=dev-hablator-api-token
